/// Parámetro de campo del gráfico de líneas: una fila por serie diaria (consumo y pronóstico de electricidad, Henry Hub, WTI y Brent). La relación con Sector deja solo las series del sector elegido.
table 'Serie del gráfico'
	lineageTag: 0e35b996-e5b3-4d2a-b262-37903c44e0a6

	column 'Serie del gráfico Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d60bd229-dea9-447c-96ec-295fb923a91f
		summarizeBy: sum
		sourceColumn: [Value3]

	column 'Serie del gráfico Fields'
		dataType: string
		isHidden
		lineageTag: 803d849d-34f3-4130-8414-3f1a4a1a7a8f
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Serie del gráfico Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

	column 'Serie del gráfico'
		dataType: string
		lineageTag: e67ef047-6423-4132-81a2-ea85c778c6fc
