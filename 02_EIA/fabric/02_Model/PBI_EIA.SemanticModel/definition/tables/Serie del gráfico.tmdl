		sourceColumn: [Value1]
		sortByColumn: 'Serie del gráfico Order'

		relatedColumnDetails
			groupByColumn: 'Serie del gráfico Fields'

	/// Sector al que pertenece cada serie. Se relaciona con Sector[Sector] para que el gráfico muestre solo las líneas del sector elegido.
	column Sector = SWITCH ( 'Serie del gráfico'[Serie del gráfico Order], 0, "Electricidad", 1, "Electricidad", 2, "Gas natural", "Petróleo" )
		dataType: string
		isHidden
		lineageTag: 81ffe050-5a15-471e-a715-c596d76f7cf9
		summarizeBy: none

	partition 'Serie del gráfico' = calculated
		mode: import
		source =
				{
				    ("Consumo real", NAMEOF('Medidas'[Consumo diario]), 0),
				    ("Pronóstico del día anterior", NAMEOF('Medidas'[Pronóstico diario]), 1),
				    ("Henry Hub (precio del día)", NAMEOF('Medidas'[Henry Hub diario]), 2),
				    ("WTI (EE. UU.)", NAMEOF('Medidas'[WTI diario]), 3),
