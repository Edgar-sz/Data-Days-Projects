	/// Precio spot del crudo Brent (referencia internacional, mar del Norte), en US$ por barril. Se usa en el gráfico diario.
	measure 'Brent diario' = CALCULATE ( AVERAGE ( fact_precios_diarios[precio] ), fact_precios_diarios[serie] = "RBRTE" )
