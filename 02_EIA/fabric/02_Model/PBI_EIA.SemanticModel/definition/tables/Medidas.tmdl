	/// Inventario de destilados (diésel y combustible de calefacción), en millones de barriles (M bbl), última semana.
	measure 'Destilados almacenados' =
			VAR _d = [Fecha de inventarios]
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WDISTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
