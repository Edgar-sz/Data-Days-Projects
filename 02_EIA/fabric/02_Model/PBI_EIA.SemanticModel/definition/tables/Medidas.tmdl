	/// Cantidad de tablas Silver (de 9) cuyo último dato está dentro del plazo de su frecuencia: 7 días (diaria), 14 (semanal) o 120 (mensual).
	measure 'Tablas al día' =
			VAR _hoy = TODAY ()
			VAR _t =
			    {
			        ( [Último dato · Demanda por región], 7 ),
			        ( [Último dato · Generación por fuente], 7 ),
			        ( [Último dato · Intercambio entre regiones], 7 ),
			        ( [Último dato · Precio spot del crudo], 7 ),
			        ( [Último dato · Precio minorista de combustibles], 14 ),
			        ( [Último dato · Inventarios semanales], 14 ),
			        ( [Último dato · Precio Henry Hub], 7 ),
			        ( [Último dato · Almacenamiento de gas], 14 ),
			        ( [Último dato · Consumo de gas por sector], 120 )
			    }
			RETURN
			    COUNTROWS ( FILTER ( _t, NOT ISBLANK ( [Value1] ) && DATEDIFF ( [Value1], _hoy, DAY ) <= [Value2] ) ) + 0
		formatString: 0
		displayFolder: 5. Frescura
		lineageTag: 3180d658-9d3c-4aef-98c4-a4b20725d8bd

	/// Texto del botón que abre el panel de frescura, por ejemplo 'Frescura 9/9'.
	measure 'Texto del botón de frescura' = "Frescura " & [Tablas al día] & "/9"
		displayFolder: 5. Frescura
		lineageTag: 604ff77c-efbe-4d80-99b1-8f8413e5cca7

	/// Contenido del banner: degradado del sector, ilustración isométrica animada (SVG + CSS) y píldora con la fecha del último dato. No se usa directo en el informe: lo envuelve [HTML Escena] con el alto fijo del banner.
	measure 'HTML Escena contenido' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			VAR _svg = SWITCH ( _s, "gas", "<svg viewBox='0 0 640 420' preserveAspectRatio='xMidYMid meet'><defs><linearGradient id='gas-suelo' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#E1EEF6'/><stop offset='1' stop-color='#BCD6E6'/></linearGradient>
			<linearGradient id='el-panel' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#3B6FB6'/><stop offset='.55' stop-color='#1E3F78'/><stop offset='1' stop-color='#28508F'/></linearGradient>
			<linearGradient id='gas-cil' x1='0' x2='1'><stop offset='0' stop-color='#E9EEF4'/><stop offset='.45' stop-color='#FFFFFF'/><stop offset='1' stop-color='#B8C4D3'/></linearGradient>
			<radialGradient id='gas-esf' cx='.35' cy='.3' r='.8'><stop offset='0' stop-color='#FFFFFF'/><stop offset='.6' stop-color='#E3EAF2'/><stop offset='1' stop-color='#AEBCCD'/></radialGradient>
