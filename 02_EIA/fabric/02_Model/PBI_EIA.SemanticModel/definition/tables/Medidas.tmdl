			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "WGTSTUS1", fact_inventarios_semanales[fecha] < _u, REMOVEFILTERS ( dim_fecha ) )
			RETURN
