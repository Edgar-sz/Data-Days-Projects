	/// Última fecha disponible en silver.consumo_gas_sector (frecuencia mensual; se considera al día hasta 120 días de antigüedad).
	measure 'Último dato · Consumo de gas por sector' = CALCULATE ( MAX ( fact_consumo_gas_mensual[fecha] ), REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
		isHidden
