/// Tabla contenedora de medidas DAX (no tiene datos). Carpetas: 0. Sector, 1. Electricidad, 2. Gas natural, 3. Petróleo, 4. Gráficos, 5. Frescura y 6. HTML.
table Medidas
	lineageTag: e2d667d4-dea4-47a9-b298-1488d7bbd71c

	/// Clave del sector elegido en la segmentación de botones: el (Electricidad), gas (Gas natural) o pet (Petróleo). Si no hay selección se usa Electricidad. Todas las medidas visuales dependen de ella.
	measure 'Sector seleccionado' = SELECTEDVALUE ( Sector[Clave], "el" )
		displayFolder: 0. Sector
		lineageTag: dfe0cde5-bff8-4e88-a8a4-0f6f77f4a8af

	/// Color de acento del sector elegido. Se usa en formato condicional (barra destacada, líneas) y en los HTML.
	measure 'Color del sector' = SWITCH ( [Sector seleccionado], "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
		displayFolder: 0. Sector
		lineageTag: 94c51e0b-a473-49a7-b25c-be37dd39cc4f

	/// Título principal del banner según el sector elegido.
	measure 'Título del sector' = SWITCH ( [Sector seleccionado], "gas", "Gas natural", "pet", "Petróleo", "Electricidad" )
		displayFolder: 0. Sector
		lineageTag: a97bb6d2-72d2-46f4-9d22-ae16ef12ffb4

	/// Frase que explica en lenguaje simple qué muestra el tablero para el sector elegido.
	measure 'Subtítulo del sector' =
			SWITCH (
			    [Sector seleccionado],
			    "gas", "Precio de referencia, gas guardado para el invierno y en qué se consume.",
			    "pet", "Precio del crudo, gasolina y diésel en el surtidor, y cuánto petróleo hay guardado.",
			    "Consumo diario del país, con qué fuentes se genera y qué tan bien lo pronostica la red."
			)
		displayFolder: 0. Sector
		lineageTag: 47b79d64-2f76-4bca-895c-d137d1e61228

	/// Fecha del dato principal del sector: último día cerrado de electricidad, último precio Henry Hub o último precio WTI.
	measure 'Fecha del último dato' = SWITCH ( [Sector seleccionado], "gas", [Fecha del Henry Hub], "pet", [Fecha del WTI], [Día cerrado de electricidad] )
		formatString: d mmm yyyy
		displayFolder: 0. Sector
		lineageTag: a9f2b3b6-80f7-4b95-9d59-801d8c06727e

	/// Texto 'Último dato: d mmm aaaa' para la píldora del banner.
	measure 'Texto del último dato' = "Último dato: " & SUBSTITUTE ( FORMAT ( [Fecha del último dato], "d mmm yyyy", "es-ES" ), ".", "" )
		displayFolder: 0. Sector
		lineageTag: dc48808d-ae05-4e90-81e5-fe1150b6611d

	/// Demanda eléctrica de los 48 estados contiguos (US48) en teravatios-hora (TWh = 1 millón de MWh). Responde al filtro de fecha; se usa en el gráfico diario.
	measure 'Consumo diario' = CALCULATE ( DIVIDE ( SUM ( fact_electricidad_diaria[demanda_mwh] ), 1000000 ), fact_electricidad_diaria[region] = "US48" )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: bad31970-d64b-4ad8-9713-d964bd873b28

	/// Demanda que los operadores de la red pronosticaron el día anterior (day-ahead) para US48, en TWh. La EIA solo la recopila (formulario EIA-930).
	measure 'Pronóstico diario' = CALCULATE ( DIVIDE ( SUM ( fact_electricidad_diaria[pronostico_demanda_mwh] ), 1000000 ), fact_electricidad_diaria[region] = "US48" )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: fb870959-7367-487b-b5dc-d8152e39b54a

	/// Generación neta de las centrales de US48, en TWh.
	measure 'Generación diaria' = CALCULATE ( DIVIDE ( SUM ( fact_electricidad_diaria[generacion_neta_mwh] ), 1000000 ), fact_electricidad_diaria[region] = "US48" )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: c9285730-c814-49f6-b288-22113ca6501b

	/// Intercambio total de US48 con Canadá y México, en TWh. Negativo: el país importa electricidad.
	measure 'Intercambio diario' = CALCULATE ( DIVIDE ( SUM ( fact_electricidad_diaria[intercambio_total_mwh] ), 1000000 ), fact_electricidad_diaria[region] = "US48" )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 1f48fe74-48d2-4860-bcd4-a403d73636d7

	/// Último día con datos completos de electricidad. Silver solo guarda días con al menos dos días de antigüedad, porque la EIA publica el día en curso incompleto.
	measure 'Día cerrado de electricidad' = CALCULATE ( MAX ( fact_electricidad_diaria[fecha] ), REMOVEFILTERS ( dim_fecha ), fact_electricidad_diaria[region] = "US48" )
		formatString: d mmm yyyy
		displayFolder: 1. Electricidad
		lineageTag: 8c1a259b-7d36-474b-9362-2d7228019fa2

	/// Consumo de US48 en el último día cerrado, en TWh. No responde al filtro de año.
	measure 'Consumo del último día' =
			VAR _d = [Día cerrado de electricidad] - 0
			RETURN
			    CALCULATE ( [Consumo diario], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 09231c57-2d41-423f-a05a-362b122587ed

	/// Consumo de US48 el día previo al último día cerrado, en TWh.
	measure 'Consumo del día anterior' =
			VAR _d = [Día cerrado de electricidad] - 1
			RETURN
			    CALCULATE ( [Consumo diario], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 9713e986-d288-4f06-a580-9eb07d12accd

	/// Cambio porcentual del consumo del último día cerrado frente al día anterior.
	measure 'Variación del consumo' = DIVIDE ( [Consumo del último día] - [Consumo del día anterior], [Consumo del día anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1. Electricidad
		lineageTag: 75326324-1c33-48ec-b228-be37a0ba6c07

	/// Pronóstico del día anterior para el último día cerrado, en TWh.
	measure 'Pronóstico del último día' =
			VAR _d = [Día cerrado de electricidad] - 0
			RETURN
			    CALCULATE ( [Pronóstico diario], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 6c6b36a2-d255-4491-b539-36d3229c0014

	/// Diferencia entre pronóstico y consumo real, como porcentaje del consumo. Negativo: se pronosticó menos de lo que se consumió.
	measure 'Error del pronóstico' = DIVIDE ( [Pronóstico del último día] - [Consumo del último día], [Consumo del último día] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1. Electricidad
		lineageTag: 32983101-d75b-4cfa-95b6-e13f9976e07e

	/// Generación neta de US48 en el último día cerrado, en TWh.
	measure 'Generación del último día' =
			VAR _d = [Día cerrado de electricidad] - 0
			RETURN
			    CALCULATE ( [Generación diaria], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 32c147d4-1ac3-4422-82e8-b7aad7fa3f7e

	/// Parte del consumo del último día cubierta con generación propia; el resto se importa.
	measure 'Cobertura de la generación' = DIVIDE ( [Generación del último día], [Consumo del último día] )
		formatString: 0.0%
		displayFolder: 1. Electricidad
		lineageTag: 2e5b5486-d0bc-42a1-8400-080c1e2b926f

	/// Intercambio total de US48 en el último día cerrado, en TWh. Negativo: importación neta.
	measure 'Intercambio del último día' =
			VAR _d = [Día cerrado de electricidad] - 0
			RETURN
			    CALCULATE ( [Intercambio diario], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: f06f562a-8e4e-4dac-b8f7-728ff9d33d0c

	/// Consumo de US48 hace 52 semanas (364 días), el mismo día de la semana, en TWh.
	measure 'Consumo hace un año' =
			VAR _d = [Día cerrado de electricidad] - 364
			RETURN
			    CALCULATE ( [Consumo diario], REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: d6bca64c-71d7-4ffd-ba22-6d3285f9ad81

	/// Cambio porcentual del consumo del último día cerrado frente al mismo día del año anterior.
	measure 'Variación del consumo vs hace un año' = DIVIDE ( [Consumo del último día] - [Consumo hace un año], [Consumo hace un año] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1. Electricidad
		lineageTag: 02b24012-0623-4b57-a2d4-82093cefee98

	/// Mayor consumo diario de US48 desde enero de 2023, en TWh.
	measure 'Récord de consumo' = CALCULATE ( MAXX ( VALUES ( dim_fecha[fecha] ), [Consumo diario] ), REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 42d48766-c00f-4f1b-801e-9aacf5d48365

	/// Día en que se registró el récord de consumo.
	measure 'Fecha del récord de consumo' =
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dim_fecha[fecha] ), "@consumo", [Consumo diario] ),
			        REMOVEFILTERS ( dim_fecha )
			    )
			RETURN
			    MAXX ( TOPN ( 1, _t, [@consumo], DESC ), dim_fecha[fecha] )
		formatString: d mmm yyyy
		displayFolder: 1. Electricidad
		lineageTag: e5cd0355-e41c-4fe8-b50b-d774f6509ad8

	/// Consumo del último día como porcentaje del récord del período. Llena la barra de progreso de la tarjeta.
	measure 'Consumo vs récord' = DIVIDE ( [Consumo del último día], [Récord de consumo] )
		formatString: 0%
		displayFolder: 1. Electricidad
		lineageTag: 3f6c90e2-05f2-4dde-bf08-7b9acaf63221

	/// Suma de la generación positiva por fuente de US48 en el último día cerrado, en MWh. Base de las participaciones (el almacenamiento resta cuando carga).
	measure 'Generación positiva del último día' =
			VAR _d = [Día cerrado de electricidad]
			RETURN
			    CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ), REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0 )
		formatString: #,0
		isHidden
		displayFolder: 1. Electricidad
		lineageTag: 3df79b79-462e-4719-a420-8a4288952ffc

	/// Participación de las fuentes renovables (eólica, solar, hidroeléctrica, geotérmica y solar o eólica con baterías) en la generación del último día cerrado.
	measure 'Energía renovable' =
			VAR _d = [Día cerrado de electricidad]
			VAR _renovable =
			    CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ), REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0, dim_fuente_generacion[es_renovable] = TRUE () )
			RETURN
			    DIVIDE ( _renovable, [Generación positiva del último día] )
		formatString: 0.0%
		displayFolder: 1. Electricidad
		lineageTag: 7dd4df69-82f9-4967-a41b-033fb3d4ba96

	/// Fuente con mayor generación en el último día cerrado.
	measure 'Fuente principal' =
			VAR _d = [Día cerrado de electricidad]
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dim_fuente_generacion[nombre_fuente] ), "@gen", CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ) ) ),
			        REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0
			    )
			VAR _top = TOPN ( 1, _t, [@gen], DESC )
			RETURN
			    MAXX ( _top, dim_fuente_generacion[nombre_fuente] )
		displayFolder: 1. Electricidad
		lineageTag: d3282a2e-3b32-447e-80b9-57f0d3ceb50e

	/// Parte de la generación del último día que aportó la fuente principal.
	measure 'Participación de la fuente principal' =
			VAR _d = [Día cerrado de electricidad]
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dim_fuente_generacion[nombre_fuente] ), "@gen", CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ) ) ),
			        REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0
			    )
			VAR _top = TOPN ( 1, _t, [@gen], DESC )
			RETURN
			    DIVIDE ( MAXX ( _top, [@gen] ), [Generación positiva del último día] )
		formatString: 0.0%
		displayFolder: 1. Electricidad
		lineageTag: 19749250-471c-4c9a-816c-d119b3e6017e

	/// Operador de la red con mayor consumo en el último día cerrado, con su nombre corto habitual (PJM, MISO, ERCOT, SPP, CAISO, NYISO, ISO-NE).
	measure 'Región con más consumo' =
			VAR _d = [Día cerrado de electricidad]
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dim_region_electrica[region] ), dim_region_electrica[region] <> "US48" ),
			            "@consumo", CALCULATE ( SUM ( fact_electricidad_diaria[demanda_mwh] ) )
			        ),
			        REMOVEFILTERS ( dim_fecha ),
			        dim_fecha[fecha] = _d
			    )
			VAR _top = TOPN ( 1, _t, [@consumo], DESC )
			VAR _r = MAXX ( _top, dim_region_electrica[region] )
			RETURN
			    SWITCH ( _r, "ERCO", "ERCOT", "SWPP", "SPP", "CISO", "CAISO", "NYIS", "NYISO", "ISNE", "ISO-NE", _r )
		displayFolder: 1. Electricidad
		lineageTag: f367137b-3843-478b-88ac-2351e3bdd65b

	/// Consumo de la región con más consumo en el último día cerrado, en TWh.
	measure 'Consumo de la región líder' =
			VAR _d = [Día cerrado de electricidad]
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dim_region_electrica[region] ), dim_region_electrica[region] <> "US48" ),
			            "@consumo", CALCULATE ( SUM ( fact_electricidad_diaria[demanda_mwh] ) )
			        ),
			        REMOVEFILTERS ( dim_fecha ),
			        dim_fecha[fecha] = _d
			    )
			VAR _top = TOPN ( 1, _t, [@consumo], DESC )
			RETURN
			    DIVIDE ( MAXX ( _top, [@consumo] ), 1000000 )
		formatString: #,0.00
		displayFolder: 1. Electricidad
		lineageTag: 6f4fb772-81c0-4b33-b84d-814154279259

	/// Parte del consumo de US48 que corresponde a la región con más consumo.
	measure 'Participación de la región líder' = DIVIDE ( [Consumo de la región líder], [Consumo del último día] )
		formatString: 0.0%
		displayFolder: 1. Electricidad
		lineageTag: 4282283a-af82-4330-9868-6f80c177ff9d

	/// Precio spot (del día) del gas natural en Henry Hub, Luisiana, en US$ por millón de BTU (MMBtu). Responde al filtro de fecha; se usa en el gráfico diario.
	measure 'Henry Hub diario' = CALCULATE ( AVERAGE ( fact_precios_diarios[precio] ), fact_precios_diarios[serie] = "RNGWHHD" )
		formatString: #,0.00
		displayFolder: 2. Gas natural
		lineageTag: 92a488cb-f104-4fa3-8122-737913b40bd6

	/// Fecha del último precio Henry Hub publicado.
	measure 'Fecha del Henry Hub' = CALCULATE ( MAX ( fact_ultimo_precio[fecha] ), fact_ultimo_precio[serie] = "RNGWHHD" )
		formatString: d mmm yyyy
		displayFolder: 2. Gas natural
		lineageTag: 61811268-06ab-4d92-99d2-7060ccc0e63f

	/// Último precio spot Henry Hub, en US$/MMBtu.
	measure 'Henry Hub último' = CALCULATE ( MAX ( fact_ultimo_precio[precio] ), fact_ultimo_precio[serie] = "RNGWHHD" )
		formatString: #,0.00
		displayFolder: 2. Gas natural
		lineageTag: ea5a7231-75c5-4fbe-954e-ff9c16f78bbe

	/// Cambio del último precio Henry Hub frente al dato anterior. Gold lo guarda en puntos porcentuales; se divide entre 100.
	measure 'Variación del Henry Hub' = DIVIDE ( CALCULATE ( MAX ( fact_ultimo_precio[variacion_pct] ), fact_ultimo_precio[serie] = "RNGWHHD" ), 100 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Gas natural
		lineageTag: 6a98c6dd-6911-48e9-bb45-c6d81299fc90

	/// Precio Henry Hub más alto desde enero de 2023.
	measure 'Máximo del Henry Hub' = CALCULATE ( MAX ( fact_precios_diarios[precio] ), fact_precios_diarios[serie] = "RNGWHHD", REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0.00
		displayFolder: 2. Gas natural
		lineageTag: 9808dc8e-f9ae-491d-86eb-f5279cf68fa5

	/// Día del precio Henry Hub más alto del período.
	measure 'Fecha del máximo del Henry Hub' =
			VAR _max = [Máximo del Henry Hub]
			RETURN
			    CALCULATE ( MAX ( fact_precios_diarios[fecha] ), fact_precios_diarios[serie] = "RNGWHHD", fact_precios_diarios[precio] = _max, REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
		displayFolder: 2. Gas natural
		lineageTag: 4ba9dc89-d399-4594-8ab7-a0a28005b2d7

	/// Último precio como porcentaje del máximo del período.
	measure 'Henry Hub vs máximo' = DIVIDE ( [Henry Hub último], [Máximo del Henry Hub] )
		formatString: 0%
		displayFolder: 2. Gas natural
		lineageTag: 9058ac1b-dad9-4af8-8af0-eb196aefc83f

	/// Promedio de los precios diarios Henry Hub del mes del último dato (tabla fact_precios_mensuales).
	measure 'Promedio del mes del Henry Hub' =
			VAR _d = [Fecha del Henry Hub]
			RETURN
			    CALCULATE (
			        MAX ( fact_precios_mensuales[precio_promedio] ),
			        fact_precios_mensuales[serie] = "RNGWHHD",
			        fact_precios_mensuales[fecha_mes] = DATE ( YEAR ( _d ), MONTH ( _d ), 1 ),
			        REMOVEFILTERS ( dim_fecha )
			    )
		formatString: #,0.00
		displayFolder: 2. Gas natural
		lineageTag: cbc137aa-35d4-466a-95d7-f666646810ea

	/// Semana del último dato de gas almacenado en los 48 estados contiguos (Lower 48).
	measure 'Fecha del almacenamiento' = CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
		displayFolder: 2. Gas natural
		lineageTag: 00478261-c876-4237-9084-2376ba8e6204

	/// Gas natural en almacenamiento subterráneo en Lower 48, en miles de millones de pies cúbicos (Bcf), última semana.
	measure 'Gas almacenado' =
			VAR _d = [Fecha del almacenamiento]
			RETURN
			    CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 57ee1778-f731-4052-94df-265e2456174b

	/// Gas almacenado en Lower 48 la semana previa al último dato, en Bcf.
	measure 'Gas almacenado la semana anterior' =
			VAR _u = [Fecha del almacenamiento]
			VAR _d =
			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", fact_inventarios_semanales[fecha] < _u, REMOVEFILTERS ( dim_fecha ) )
			RETURN
			    CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 6c12ba9a-c37a-4121-b97f-4b95cbf83048

	/// Gas que entró (+) o salió (−) del almacenamiento en la última semana, en Bcf.
	measure 'Cambio semanal del gas almacenado' = [Gas almacenado] - [Gas almacenado la semana anterior]
		formatString: +#,0;-#,0;0
		displayFolder: 2. Gas natural
		lineageTag: 77517a90-9ca2-47d6-b023-9e16f3ce3f21

	/// Cambio porcentual del gas almacenado frente a la semana anterior.
	measure 'Variación semanal del gas almacenado' = DIVIDE ( [Cambio semanal del gas almacenado], [Gas almacenado la semana anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Gas natural
		lineageTag: d73dcdeb-a1d8-496d-bb8b-c7e6b2c48be4

	/// Gas almacenado en Lower 48 hace 52 semanas, en Bcf.
	measure 'Gas almacenado hace un año' =
			VAR _d = [Fecha del almacenamiento] - 364
			RETURN
			    CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 3c942021-1ea4-4cf4-9e86-2595bfcf5d97

	/// Cambio porcentual del gas almacenado frente a la misma semana del año anterior.
	measure 'Variación del gas almacenado vs hace un año' = DIVIDE ( [Gas almacenado] - [Gas almacenado hace un año], [Gas almacenado hace un año] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Gas natural
		lineageTag: c1a45f45-f860-4b9c-bd4a-06672e413f3b

	/// Mayor nivel semanal de gas almacenado en Lower 48 desde enero de 2023, en Bcf.
	measure 'Máximo de gas almacenado' = CALCULATE ( MAX ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", REMOVEFILTERS ( dim_fecha ) )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: cdea8973-b1d8-4bf6-b837-011469e97cd7

	/// Semana del máximo de gas almacenado.
	measure 'Fecha del máximo de gas almacenado' =
			VAR _max = [Máximo de gas almacenado]
			RETURN
			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF", fact_inventarios_semanales[valor] = _max, REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
		displayFolder: 2. Gas natural
		lineageTag: 98183c66-fda8-473d-a8c8-494f95ff6d3c

	/// Gas almacenado como porcentaje del máximo del período.
	measure 'Gas almacenado vs máximo' = DIVIDE ( [Gas almacenado], [Máximo de gas almacenado] )
		formatString: 0%
		displayFolder: 2. Gas natural
		lineageTag: ecabf4e5-7118-4a55-a262-160170071378

	/// Cantidad de semanas consecutivas, hasta la última, en que el gas almacenado subió frente a la semana anterior.
	measure 'Semanas seguidas en aumento' =
			VAR _t =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( fact_inventarios_semanales[fecha] ), "@valor", CALCULATE ( SUM ( fact_inventarios_semanales[valor] ) ) ),
			        fact_inventarios_semanales[serie] = "NW2_EPG0_SWO_R48_BCF",
			        REMOVEFILTERS ( dim_fecha )
			    )
			VAR _t2 =
			    ADDCOLUMNS (
			        _t,
			        "@previo",
			            VAR _f = fact_inventarios_semanales[fecha]
			            RETURN MAXX ( TOPN ( 1, FILTER ( _t, fact_inventarios_semanales[fecha] < _f ), fact_inventarios_semanales[fecha], DESC ), [@valor] )
			    )
			VAR _corte = MAXX ( FILTER ( _t2, NOT ISBLANK ( [@previo] ) && [@valor] <= [@previo] ), fact_inventarios_semanales[fecha] )
			RETURN
			    COUNTROWS ( FILTER ( _t2, fact_inventarios_semanales[fecha] > _corte ) )
		formatString: 0
		displayFolder: 2. Gas natural
		lineageTag: 2f46b4ec-a5ea-4271-ae98-627588a27836

	/// Región de almacenamiento (de las cinco que define la EIA) con más gas en la última semana.
	measure 'Región con más gas almacenado' =
			VAR _d = [Fecha del almacenamiento]
			VAR _t =
			    ADDCOLUMNS (
			        DATATABLE (
			            "Codigo", STRING, "Region", STRING,
			            {
			                { "NW2_EPG0_SWO_R31_BCF", "Este" },
			                { "NW2_EPG0_SWO_R32_BCF", "Medio Oeste" },
			                { "NW2_EPG0_SWO_R33_BCF", "Centro Sur" },
			                { "NW2_EPG0_SWO_R34_BCF", "Montaña" },
			                { "NW2_EPG0_SWO_R35_BCF", "Pacífico" }
			            }
			        ),
			        "@valor",
			            CALCULATE (
			                SUM ( fact_inventarios_semanales[valor] ),
			                TREATAS ( { [Codigo] }, fact_inventarios_semanales[serie] ),
			                fact_inventarios_semanales[fecha] = _d,
			                REMOVEFILTERS ( dim_fecha )
			            )
			    )
			VAR _top = TOPN ( 1, _t, [@valor], DESC )
			RETURN
			    MAXX ( _top, [Region] )
		displayFolder: 2. Gas natural
		lineageTag: fa9d131c-7c72-4030-ad21-a92899e86ebd

	/// Gas almacenado en la región con más gas, en Bcf.
	measure 'Gas en la región líder' =
			VAR _d = [Fecha del almacenamiento]
			VAR _t =
			    ADDCOLUMNS (
			        DATATABLE (
			            "Codigo", STRING, "Region", STRING,
			            {
			                { "NW2_EPG0_SWO_R31_BCF", "Este" },
			                { "NW2_EPG0_SWO_R32_BCF", "Medio Oeste" },
			                { "NW2_EPG0_SWO_R33_BCF", "Centro Sur" },
			                { "NW2_EPG0_SWO_R34_BCF", "Montaña" },
			                { "NW2_EPG0_SWO_R35_BCF", "Pacífico" }
			            }
			        ),
			        "@valor",
			            CALCULATE (
			                SUM ( fact_inventarios_semanales[valor] ),
			                TREATAS ( { [Codigo] }, fact_inventarios_semanales[serie] ),
			                fact_inventarios_semanales[fecha] = _d,
			                REMOVEFILTERS ( dim_fecha )
			            )
			    )
			VAR _top = TOPN ( 1, _t, [@valor], DESC )
			RETURN
			    MAXX ( _top, [@valor] )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 5148ef2b-8c21-486d-808b-726e8125511f

	/// Parte del gas almacenado del país que está en la región líder.
	measure 'Participación de la región líder de gas' = DIVIDE ( [Gas en la región líder], [Gas almacenado] )
		formatString: 0.0%
		displayFolder: 2. Gas natural
		lineageTag: b1f220b7-ce6f-41e2-986b-f4496d8ff9d7

	/// Último mes con consumo de gas publicado. La EIA lo publica con unos tres meses de retraso.
	measure 'Fecha del consumo de gas' = CALCULATE ( MAX ( fact_consumo_gas_mensual[fecha] ), fact_consumo_gas_mensual[serie] = "N9140US2", REMOVEFILTERS ( dim_fecha ) )
		formatString: mmmm yyyy
		displayFolder: 2. Gas natural
		lineageTag: 869d4f1e-9358-4fbc-9724-92ff6af57523

	/// Consumo total de gas natural de EE. UU. en el último mes publicado, en Bcf.
	measure 'Consumo de gas del mes' =
			VAR _d = [Fecha del consumo de gas]
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_consumo_gas_mensual[consumo_mmcf] ), fact_consumo_gas_mensual[serie] = "N9140US2", fact_consumo_gas_mensual[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 0fd281aa-a6b4-4bc4-9331-b3c8556d283b

	/// Consumo total de gas del mes previo al último publicado, en Bcf.
	measure 'Consumo de gas del mes anterior' =
			VAR _d = EDATE ( [Fecha del consumo de gas], -1 )
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_consumo_gas_mensual[consumo_mmcf] ), fact_consumo_gas_mensual[serie] = "N9140US2", fact_consumo_gas_mensual[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0
		displayFolder: 2. Gas natural
		lineageTag: 9782567f-e225-4b48-b026-8931261eca63

	/// Cambio porcentual del consumo de gas frente al mes anterior.
	measure 'Variación del consumo de gas' = DIVIDE ( [Consumo de gas del mes] - [Consumo de gas del mes anterior], [Consumo de gas del mes anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Gas natural
		lineageTag: 1a534e61-f4ae-4270-b9a4-a4a0236bd53b

	/// Parte del gas consumido en el último mes que se usó para generar electricidad.
	measure 'Gas para generar electricidad' =
			VAR _d = [Fecha del consumo de gas]
			VAR _electricidad =
			    CALCULATE ( SUM ( fact_consumo_gas_mensual[consumo_mmcf] ), fact_consumo_gas_mensual[serie] = "N3045US2", fact_consumo_gas_mensual[fecha] = _d, REMOVEFILTERS ( dim_fecha ) )
			VAR _total =
			    CALCULATE ( SUM ( fact_consumo_gas_mensual[consumo_mmcf] ), fact_consumo_gas_mensual[serie] = "N9140US2", fact_consumo_gas_mensual[fecha] = _d, REMOVEFILTERS ( dim_fecha ) )
			RETURN
			    DIVIDE ( _electricidad, _total )
		formatString: 0.0%
		displayFolder: 2. Gas natural
		lineageTag: 5e9defcf-10cd-46d0-a69e-e7865cee1c58

	/// Último dato del contrato futuro a un mes de Henry Hub (RNGC1). La serie dejó de publicarse en abril de 2024.
	measure 'Fecha del último futuro' = CALCULATE ( MAX ( fact_precios_diarios[fecha] ), fact_precios_diarios[serie] = "RNGC1", REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
