	/// Cambio porcentual del inventario de gasolina terminada y componentes frente a la semana anterior.
	measure 'Variación de gasolina almacenada' = DIVIDE ( [Gasolina almacenada] - [Gasolina almacenada la semana anterior], [Gasolina almacenada la semana anterior] )
