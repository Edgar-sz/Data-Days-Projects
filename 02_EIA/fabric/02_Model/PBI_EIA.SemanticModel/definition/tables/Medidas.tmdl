	/// Precio spot del crudo WTI (West Texas Intermediate, referencia de EE. UU.) en Cushing, Oklahoma, en US$ por barril. Se usa en el gráfico diario.
	measure 'WTI diario' = CALCULATE ( AVERAGE ( fact_precios_diarios[precio] ), fact_precios_diarios[serie] = "RWTC" )
