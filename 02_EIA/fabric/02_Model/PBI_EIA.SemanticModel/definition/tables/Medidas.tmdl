	/// Semana del último dato de inventarios de petróleo.
	measure 'Fecha de inventarios' = CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "WCESTUS1", REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
