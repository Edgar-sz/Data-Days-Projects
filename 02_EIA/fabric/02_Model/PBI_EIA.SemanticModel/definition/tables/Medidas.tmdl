	/// Inventario de crudo comercial (sin la reserva estratégica), en millones de barriles (M bbl), última semana.
	measure 'Crudo almacenado' =
			VAR _d = [Fecha de inventarios]
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WCESTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
		displayFolder: 3. Petróleo
		lineageTag: 20ffc8e4-fbca-403c-9007-21ffef45f66b

	/// Inventario de crudo comercial (sin la reserva estratégica) la semana previa, en M bbl.
	measure 'Crudo almacenado la semana anterior' =
			VAR _u = [Fecha de inventarios]
			VAR _d =
			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "WCESTUS1", fact_inventarios_semanales[fecha] < _u, REMOVEFILTERS ( dim_fecha ) )
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WCESTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
		isHidden
		displayFolder: 3. Petróleo
		lineageTag: e03566a7-e7bc-4d50-82f4-f85d187304fc

	/// Cambio porcentual del inventario de crudo comercial frente a la semana anterior.
	measure 'Variación de crudo almacenado' = DIVIDE ( [Crudo almacenado] - [Crudo almacenado la semana anterior], [Crudo almacenado la semana anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Petróleo
		lineageTag: 3f536466-4dd7-44e0-9d73-9121e0ae5aa1

	/// Inventario de la Reserva Estratégica de Petróleo del gobierno de EE. UU., en millones de barriles (M bbl), última semana.
	measure 'Reserva estratégica' =
			VAR _d = [Fecha de inventarios]
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WCSSTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
		displayFolder: 3. Petróleo
		lineageTag: 3257facb-d8c8-4c82-ba6b-0d2d69b20116

	/// Inventario de la Reserva Estratégica de Petróleo del gobierno de EE. UU. la semana previa, en M bbl.
	measure 'Reserva estratégica la semana anterior' =
			VAR _u = [Fecha de inventarios]
			VAR _d =
			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "WCSSTUS1", fact_inventarios_semanales[fecha] < _u, REMOVEFILTERS ( dim_fecha ) )
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WCSSTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
