		lineageTag: 6f20b2b3-9799-481f-a69f-58958fdf4da9

	/// Inventario de destilados (diésel y combustible de calefacción) la semana previa, en M bbl.
	measure 'Destilados almacenados la semana anterior' =
			VAR _u = [Fecha de inventarios]
			VAR _d =
			    CALCULATE ( MAX ( fact_inventarios_semanales[fecha] ), fact_inventarios_semanales[serie] = "WDISTUS1", fact_inventarios_semanales[fecha] < _u, REMOVEFILTERS ( dim_fecha ) )
			RETURN
			    DIVIDE ( CALCULATE ( SUM ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WDISTUS1", fact_inventarios_semanales[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
		isHidden
		displayFolder: 3. Petróleo
		lineageTag: 9ba39eb6-5b75-4d68-80c8-86030f18f09f

	/// Cambio porcentual del inventario de destilados frente a la semana anterior.
	measure 'Variación de destilados almacenados' = DIVIDE ( [Destilados almacenados] - [Destilados almacenados la semana anterior], [Destilados almacenados la semana anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Petróleo
		lineageTag: 5e1c7b9e-11fd-4fe1-8a89-c6e879bc5576

	/// Mayor inventario semanal de crudo comercial desde enero de 2023, en M bbl.
	measure 'Máximo de crudo almacenado' = DIVIDE ( CALCULATE ( MAX ( fact_inventarios_semanales[valor] ), fact_inventarios_semanales[serie] = "WCESTUS1", REMOVEFILTERS ( dim_fecha ) ), 1000 )
		formatString: #,0.0
		displayFolder: 3. Petróleo
		lineageTag: 419af3a0-9336-4534-9a09-2c276243684c

	/// Crudo almacenado como porcentaje del máximo del período.
	measure 'Crudo almacenado vs máximo' = DIVIDE ( [Crudo almacenado], [Máximo de crudo almacenado] )
		formatString: 0%
		displayFolder: 3. Petróleo
		lineageTag: 375e83b3-f748-4677-b405-5d3ca5761a03

	/// Valor de cada barra del gráfico de barras según el sector: participación de cada fuente en la generación (Electricidad), consumo por sector en Bcf (Gas natural) o precio en el surtidor en US$/galón (Petróleo). Usa la tabla 'Categoría de barras'.
	measure 'Valor de barra' =
			VAR _s = [Sector seleccionado]
			VAR _cod = SELECTEDVALUE ( 'Categoría de barras'[Código] )
			RETURN
			    SWITCH (
			        _s,
			        "gas",
			            VAR _d = [Fecha del consumo de gas]
			            RETURN
			                DIVIDE (
			                    CALCULATE ( SUM ( fact_consumo_gas_mensual[consumo_mmcf] ), fact_consumo_gas_mensual[serie] = _cod, fact_consumo_gas_mensual[fecha] = _d, REMOVEFILTERS ( dim_fecha ) ),
			                    1000
			                ),
			        "pet",
			            CALCULATE ( MAX ( fact_ultimo_precio[precio] ), fact_ultimo_precio[serie] = _cod ),
			        VAR _d = [Día cerrado de electricidad]
			        VAR _lista = { "NG", "NUC", "COL", "WND", "SUN", "WAT" }
			        VAR _gen =
			            IF (
			                _cod = "OTRAS",
			                CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ), REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0, NOT ( fact_generacion_diaria[fuente] IN _lista ) ),
			                CALCULATE ( SUM ( fact_generacion_diaria[generacion_mwh] ), REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] = _d, fact_generacion_diaria[region] = "US48", fact_generacion_diaria[generacion_mwh] > 0, fact_generacion_diaria[fuente] = _cod )
			            )
			        RETURN
			            DIVIDE ( _gen, [Generación positiva del último día] )
			    )
		displayFolder: 4. Gráficos
		lineageTag: fd514a2c-e6bc-42ec-bd2b-3af4e0e1ec34

		formatStringDefinition = SWITCH ( [Sector seleccionado], "gas", "#,0 ""Bcf""", "pet", """US$ ""0.00", "0.0%" )

	/// Color de cada barra: la de mayor valor dentro del sector elegido va en el color del sector y el resto en gris azulado (#C9D3DF). Devuelve vacío si la barra no tiene valor. Para comparar, calcula el valor de cada categoría quitando solo los filtros de las columnas Categoría, Orden y Código (Power BI agrega Orden porque Categoría se ordena por ella) y conserva el filtro del sector. Se usa en formato condicional del relleno.
	measure 'Color de barra' =
			VAR _valor = [Valor de barra]
			VAR _categorias =
			    CALCULATETABLE (
			        VALUES ( 'Categoría de barras'[Categoría] ),
			        REMOVEFILTERS ( 'Categoría de barras'[Categoría], 'Categoría de barras'[Orden], 'Categoría de barras'[Código] )
			    )
			VAR _max =
			    MAXX (
			        _categorias,
			        VAR _cat = 'Categoría de barras'[Categoría]
			        RETURN
			            CALCULATE (
			                [Valor de barra],
			                REMOVEFILTERS ( 'Categoría de barras'[Categoría], 'Categoría de barras'[Orden], 'Categoría de barras'[Código] ),
			                'Categoría de barras'[Categoría] = _cat
			            )
			    )
			RETURN
			    IF ( ISBLANK ( _valor ), BLANK (), IF ( _valor = _max, [Color del sector], "#C9D3DF" ) )
		displayFolder: 4. Gráficos
		lineageTag: aceaf6be-099c-4c95-b51c-73e2b2acaa24

	/// Título dinámico del gráfico de líneas.
	measure 'Título del gráfico' =
			SWITCH (
			    [Sector seleccionado],
			    "gas", "Precio diario del gas natural · Henry Hub",
			    "pet", "Precio diario del crudo · WTI y Brent",
			    "Consumo diario de electricidad vs. pronóstico"
			)
		displayFolder: 4. Gráficos
		lineageTag: 39f26295-94df-42d0-9095-e3f362ba55e4

	/// Unidad y alcance del gráfico de líneas.
	measure 'Subtítulo del gráfico' =
			SWITCH (
			    [Sector seleccionado],
			    "gas", "Dólares por millón de BTU",
			    "pet", "Dólares por barril",
			    "Teravatios-hora por día · 48 estados contiguos"
			)
		displayFolder: 4. Gráficos
		lineageTag: 75db3e21-7140-444c-89bb-7a73bd516abd

	/// Título dinámico del gráfico de barras, con la fecha del dato.
	measure 'Título de barras' =
			SWITCH (
			    [Sector seleccionado],
			    "gas", "En qué se consumió el gas · " & FORMAT ( [Fecha del consumo de gas], "mmmm yyyy", "es-ES" ),
			    "pet", "Precio en el surtidor · " & SUBSTITUTE ( FORMAT ( [Fecha del precio minorista], "d mmm yyyy", "es-ES" ), ".", "" ),
			    "Con qué se generó la electricidad · " & SUBSTITUTE ( FORMAT ( [Día cerrado de electricidad], "d mmm yyyy", "es-ES" ), ".", "" )
			)
		displayFolder: 4. Gráficos
		lineageTag: 8c23676f-b389-4127-9220-20eef083081f

	/// Unidad del gráfico de barras.
	measure 'Subtítulo de barras' =
			SWITCH (
			    [Sector seleccionado],
			    "gas", "Miles de millones de pies cúbicos (Bcf)",
			    "pet", "Dólares por galón · promedio de EE. UU.",
			    "Participación de cada fuente en la generación del día"
			)
		displayFolder: 4. Gráficos
		lineageTag: f235dbfd-48d5-4119-841a-48eb64518c1a

	/// Última fecha disponible en silver.rto_demanda_region (frecuencia diaria; se considera al día hasta 7 días de antigüedad).
	measure 'Último dato · Demanda por región' = CALCULATE ( MAX ( fact_electricidad_diaria[fecha] ), REMOVEFILTERS ( dim_fecha ) )
		formatString: d mmm yyyy
		isHidden
		displayFolder: 5. Frescura
		lineageTag: bfd7eb3b-c31d-4419-a4ba-1a2ddca27007

