' stroke='#E6EEF7' stroke-width='1.2'/><line x1='310' y1='293.5' x2='340' y2='308.5' stroke='rgba(255,255,255,.45)' stroke-width='.8'/><line x1='340' y1='286' x2='310' y2='316' stroke='rgba(255,255,255,.45)' stroke-width='.8'/><ellipse cx='215' cy='318' rx='11.8' ry='5.9' fill='rgba(15,30,51,.13)'/><rect x='213' y='304.2' width='4' height='13.7' rx='2' fill='#8A6040'/><circle cx='215' cy='292.3' r='12.8' fill='#4E9A3E'/><circle cx='208.1' cy='299.2' r='8.8' fill='#6CB84E'/><circle cx='221.8' cy='298.3' r='8.8' fill='#3E8432'/><circle cx='212.0' cy='287.4' r='4.9' fill='#8FD06B' opacity='.8'/><ellipse cx='412.5' cy='324.2' rx='11.7' ry='5.8' fill='rgba(15,30,51,.13)'/><rect x='410.5' y='310.5' width='4' height='13.7' rx='2' fill='#8A6040'/><circle cx='412.5' cy='298.7' r='12.7' fill='#4E9A3E'/><circle cx='405.6' cy='305.6' r='8.8' fill='#6CB84E'/><circle cx='419.3' cy='304.6' r='8.8' fill='#3E8432'/><circle cx='409.5' cy='293.9' r='4.8' fill='#8FD06B' opacity='.8'/><ellipse cx='267.5' cy='341.7' rx='13.5' ry='6.7' fill='rgba(15,30,51,.13)'/><rect x='265.5' y='326' width='4' height='15.7' rx='2' fill='#8A6040'/><circle cx='267.5' cy='312.5' r='14.6' fill='#4E9A3E'/><circle cx='259.6' cy='320.3' r='10.1' fill='#6CB84" & "E'/><circle cx='275.3' cy='319.2' r='10.1' fill='#3E8432'/><circle cx='264.1' cy='306.8' r='5.6' fill='#8FD06B' opacity='.8'/><ellipse cx='320' cy='353' rx='11.1' ry='5.5' fill='rgba(15,30,51,.13)'/><rect x='318' y='339.9' width='4' height='13.0' rx='2' fill='#8A6040'/><circle cx='320' cy='328.8' r='12.0' fill='#4E9A3E'/><circle cx='313.4' cy='335.3' r='8.3' fill='#6CB84E'/><circle cx='326.5' cy='334.4' r='8.3' fill='#3E8432'/><circle cx='317.2' cy='324.1' r='4.6' fill='#8FD06B' opacity='.8'/><path d='M424,135 Q415.7,174.3 407.5,177.7' stroke='#64748B' stroke-width='1.2' fill='none'/><path class='flujo' d='M424,135 Q415.7,174.3 407.5,177.7' stroke='#F2B01E' stroke-width='2.4' fill='none' stroke-linecap='round'/><path d='M476,135 Q508,160.5 540,158' stroke='#64748B' stroke-width='1.2' fill='none'/><path class='flujo' d='M476,135 Q508,160.5 540,158' stroke='#F2B01E' stroke-width='2.4' fill='none' stroke-linecap='round'/><circle class='part' cx='320' cy='125.5' r='2' fill='#F2B01E' style='animation-delay:0s'/><circle class='part' cx='280' cy='209' r='3' fill='#F2B01E' style='animation-delay:0.5s'/><circle class='part' cx='240' cy='117.5' r='4' fill='#F2B01E' style='animation-delay:1.1s'/><circle class='part' cx='375' cy='173.5' r='2' fill='#F2B01E' style='animation-delay:1.6s'/><circle class='part' cx='335' cy='82' r='3' fill='#F2B01E' style='animation-delay:2.2s'/><circle class='part' cx='295' cy='225.5' r='4' fill='#F2B01E' style='animation-delay:2.7s'/><circle class='part' cx='255' cy='134' r='2' fill='#F2B01E' style='animation-delay:3.3s'/><circle class='part' cx='390' cy='190' r='3' fill='#F2B01E' style='animation-delay:3.8s'/><circle class='part' cx='350' cy='98.5' r='4' fill='#F2B01E' style='animation-delay:0.4s'/><circle class='part' cx='310' cy='242' r='2' fill='#F2B01E' style='animation-delay:0.9s'/></g></svg>" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.hero{position:relative;width:100%;height:100%;border-radius:32px;overflow:hidden}.velo{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.85) 0%,rgba(255,255,255,0) 34%,rgba(255,255,255,0) 72%,rgba(255,255,255,.55) 100%)}.esc{position:absolute;left:34.2%;top:0;width:46%;height:100%}.esc svg{width:100%;height:100%}.flota{animation:flota 6s ease-in-out infinite}@keyframes flota{50%{transform:translateY(-7px)}}.spin{animation:spin linear infinite;transform-box:view-box}@keyframes spin{to{transform:rotate(360deg)}}.flujo{stroke-dasharray:5 9;animation:flujo 1.1s linear infinite}@keyframes flujo{to{stroke-dashoffset:-28}}.llama{animation:llama 1.2s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:50% 100%}@keyframes llama{0%{transform:scale(1,1)}50%{transform:scale(.92,1.12)}100%{transform:scale(1.06,.94)}}.vaiven{animation:vaiven 2.8s ease-in-out infinite alternate;transform-box:view-box}@keyframes vaiven{from{transform:rotate(-11deg)}to{transform:rotate(11deg)}}.part{animation:sube 4s ease-in infinite;opacity:0}@keyframes sube{0%{opacity:0;transform:translateY(0)}20%{opacity:.9}100%{opacity:0;transform:translateY(-70px)}}.pill{position:absolute;right:196px;top:28px;height:38px;display:flex;align-items:center;gap:8px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.88);border:1px solid #fff;font-size:12.5px;color:#4F6078;box-shadow:0 8px 20px -16px rgba(15,30,51,.5)}.pill svg{width:15px;height:15px}</style>"
			    & "<div class='hero' style='background:radial-gradient(900px 420px at 52% 70%," & _tint & " 0%," & _tint2 & " 55%,#FFFFFF 100%)'>"
			    & "<div class='velo'></div><div class='esc'>" & _svg & "</div>"
			    & "<div class='pill'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='3'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>" & [Texto del último dato] & "</div></div>"
		isHidden
		displayFolder: 6. HTML
		lineageTag: 715b0285-8fe2-41ed-bf7b-73a702dd5615

	/// Nombre del tablero, título y subtítulo del sector elegido, arriba a la izquierda del banner.
	measure 'HTML Encabezado' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.eb{font-size:11px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase}.h1{font-size:36px;font-weight:700;letter-spacing:-.6px;margin-top:6px;line-height:1.08}.p{font-size:14px;color:#4F6078;margin-top:8px;line-height:1.45}</style>"
			    & "<div class='eb' style='color:" & _act & "'>Pulso Energético de EE. UU. · datos abiertos de la EIA</div>"
			    & "<div class='h1'>" & [Título del sector] & "</div><div class='p'>" & [Subtítulo del sector] & "</div>"
		displayFolder: 6. HTML
		lineageTag: 72cedf5d-4faf-4c2d-8602-dbed59072541

	/// Las dos tarjetas grandes del banner con el indicador principal del sector, su variación y una barra de progreso frente al máximo del período. Lleva un margen interno (8, 24, 36 y 24 px) para que la sombra de las tarjetas no se corte en el borde del visual.
	measure 'HTML Tarjetas principales' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.fila{display:flex;gap:16px;padding:8px 24px 36px 24px}.kh{width:262px;height:156px;background:rgba(255,255,255,.9);border:1px solid #fff;border-radius:22px;padding:15px 18px;box-shadow:0 14px 34px -22px rgba(15,30,51,.5)}.lab{display:flex;align-items:center;gap:8px;font-size:10.5px;font-weight:700;letter-spacing:1.2px;color:#4F6078;text-transform:uppercase;white-space:nowrap}.lab i{width:22px;height:22px;border-radius:7px;display:grid;place-items:center;flex:none}.lab i svg{width:13px;height:13px}.val{font-size:34px;font-weight:700;letter-spacing:-.8px;margin-top:8px;line-height:1}.val small{font-size:14px;font-weight:600;color:#4F6078;margin-left:4px;letter-spacing:0}.sub{font-size:12px;color:#4F6078;margin-top:7px;display:flex;align-items:center;gap:6px;white-space:nowrap}.barra{height:6px;border-radius:6px;background:#E8EDF3;margin-top:11px;overflow:hidden}.barra b{display:block;height:100%;border-radius:6px}.cap{font-size:10.5px;color:#7F8EA4;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style><div class='fila'>"
			    & SWITCH (
			        _s,
			        "gas", "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z'/></svg></i>Precio del gas · Henry Hub</div><div class='val'>" & FORMAT ( [Henry Hub último], "#,0.00" ) & "<small>US$/MMBtu</small></div><div class='sub'>" & SUBSTITUTE ( FORMAT ( [Fecha del Henry Hub], "d mmm yyyy", "es-ES" ), ".", "" ) & " " & IF ( ISBLANK ( [Variación del Henry Hub] ), "", "<span class='chip " & IF ( [Variación del Henry Hub] > 0, "up", IF ( [Variación del Henry Hub] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del Henry Hub] > 0, "▲ ", IF ( [Variación del Henry Hub] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del Henry Hub] ), "0.0%" ) & "</span>" ) & " vs. día anterior" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [Henry Hub vs máximo], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & FORMAT ( [Henry Hub vs máximo], "0%" ) & " del máximo (" & FORMAT ( [Máximo del Henry Hub], "#,0.00" ) & " US$, " & SUBSTITUTE ( FORMAT ( [Fecha del máximo del Henry Hub], "d mmm yyyy", "es-ES" ), ".", "" ) & ")" & "</div></div>"
			            & "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M3 5v14a9 3 0 0 0 18 0V5'/><path d='M3 12a9 3 0 0 0 18 0'/></svg></i>Gas almacenado</div><div class='val'>" & FORMAT ( [Gas almacenado], "#,0" ) & "<small>Bcf</small></div><div class='sub'>" & SUBSTITUTE ( FORMAT ( [Fecha del almacenamiento], "d mmm yyyy", "es-ES" ), ".", "" ) & " " & IF ( ISBLANK ( [Variación semanal del gas almacenado] ), "", "<span class='chip " & IF ( [Variación semanal del gas almacenado] > 0, "up", IF ( [Variación semanal del gas almacenado] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación semanal del gas almacenado] > 0, "▲ ", IF ( [Variación semanal del gas almacenado] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación semanal del gas almacenado] ), "0.0%" ) & "</span>" ) & " vs. sem. anterior" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [Gas almacenado vs máximo], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & FORMAT ( [Gas almacenado vs máximo], "0%" ) & " del máximo (" & FORMAT ( [Máximo de gas almacenado], "#,0" ) & " Bcf, " & SUBSTITUTE ( FORMAT ( [Fecha del máximo de gas almacenado], "d mmm yyyy", "es-ES" ), ".", "" ) & ")" & "</div></div>",
			        "pet", "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 10.6 5 12.5 5 15a7 7 0 0 0 7 7z'/></svg></i>Precio del crudo · WTI</div><div class='val'>" & FORMAT ( [WTI último], "#,0.00" ) & "<small>US$/bbl</small></div><div class='sub'>" & SUBSTITUTE ( FORMAT ( [Fecha del WTI], "d mmm yyyy", "es-ES" ), ".", "" ) & " " & IF ( ISBLANK ( [Variación del WTI] ), "", "<span class='chip " & IF ( [Variación del WTI] > 0, "up", IF ( [Variación del WTI] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del WTI] > 0, "▲ ", IF ( [Variación del WTI] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del WTI] ), "0.0%" ) & "</span>" ) & " vs. día anterior" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [WTI vs máximo], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & FORMAT ( [WTI vs máximo], "0%" ) & " del máximo (" & FORMAT ( [Máximo del WTI], "#,0.00" ) & " US$, " & SUBSTITUTE ( FORMAT ( [Fecha del máximo del WTI], "d mmm yyyy", "es-ES" ), ".", "" ) & ")" & "</div></div>"
			            & "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M3 5v14a9 3 0 0 0 18 0V5'/><path d='M3 12a9 3 0 0 0 18 0'/></svg></i>Crudo almacenado</div><div class='val'>" & FORMAT ( [Crudo almacenado], "#,0.0" ) & "<small>M bbl</small></div><div class='sub'>" & SUBSTITUTE ( FORMAT ( [Fecha de inventarios], "d mmm yyyy", "es-ES" ), ".", "" ) & " " & IF ( ISBLANK ( [Variación de crudo almacenado] ), "", "<span class='chip " & IF ( [Variación de crudo almacenado] > 0, "up", IF ( [Variación de crudo almacenado] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de crudo almacenado] > 0, "▲ ", IF ( [Variación de crudo almacenado] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de crudo almacenado] ), "0.0%" ) & "</span>" ) & " vs. sem. anterior" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [Crudo almacenado vs máximo], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & FORMAT ( [Crudo almacenado vs máximo], "0%" ) & " del máximo del período (" & FORMAT ( [Máximo de crudo almacenado], "#,0.0" ) & " M bbl)" & "</div></div>",
			        "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2 4 14h7l-1 8 9-12h-7z'/></svg></i>Consumo del país</div><div class='val'>" & FORMAT ( [Consumo del último día], "#,0.00" ) & "<small>TWh</small></div><div class='sub'>" & SUBSTITUTE ( FORMAT ( [Día cerrado de electricidad], "d mmm yyyy", "es-ES" ), ".", "" ) & " " & IF ( ISBLANK ( [Variación del consumo] ), "", "<span class='chip " & IF ( [Variación del consumo] > 0, "up", IF ( [Variación del consumo] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del consumo] > 0, "▲ ", IF ( [Variación del consumo] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del consumo] ), "0.0%" ) & "</span>" ) & " vs. día anterior" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [Consumo vs récord], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & FORMAT ( [Consumo vs récord], "0%" ) & " del récord (" & FORMAT ( [Récord de consumo], "#,0.00" ) & " TWh, " & SUBSTITUTE ( FORMAT ( [Fecha del récord de consumo], "d mmm yyyy", "es-ES" ), ".", "" ) & ")" & "</div></div>"
			            & "<div class='kh'><div class='lab'><i style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z'/><path d='M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12'/></svg></i>Energía renovable</div><div class='val'>" & FORMAT ( [Energía renovable] * 100, "0.0" ) & "<small>%</small></div><div class='sub'>" & "eólica, solar, hidroeléctrica y geotérmica" & "</div><div class='barra'><b style='width:" & FORMAT ( MIN ( [Energía renovable], 1 ) * 100, "0" ) & "%;background:" & _ac & "'></b></div><div class='cap'>" & "de toda la electricidad generada el " & SUBSTITUTE ( FORMAT ( [Día cerrado de electricidad], "d mmm yyyy", "es-ES" ), ".", "" ) & "</div></div>"
			    )
			    & "</div>"
		displayFolder: 6. HTML
		lineageTag: e18622c6-8c83-48db-9c7e-976e30f8bc6b

	/// Las dos tarjetas flotantes con perspectiva del lado derecho del banner, con datos complementarios del sector.
	measure 'HTML Tarjetas flotantes' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.flot{width:300px;margin:0 0 24px auto;background:rgba(255,255,255,.86);border:1px solid #fff;border-radius:22px;padding:16px 18px;display:flex;gap:14px;align-items:center;box-shadow:0 22px 40px -26px rgba(15,30,51,.55);transform:perspective(900px) rotateY(-14deg) rotateX(3deg);transition:transform .6s}.flot:hover{transform:perspective(900px) rotateY(0) rotateX(0)}.ico{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;flex:none}.ico svg{width:22px;height:22px}.t1{font-size:11px;color:#4F6078;font-weight:600;letter-spacing:.3px}.t2{font-size:22px;font-weight:700;letter-spacing:-.4px;margin-top:1px}.t3{font-size:11.5px;color:#4F6078;margin-top:2px}.caja{padding:10px 14px 0 0}</style><div class='caja'>"
			    & SWITCH (
			        _s,
			        "gas", "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2 4 14h7l-1 8 9-12h-7z'/></svg></div><div><div class='t1'>Gas usado para generar electricidad</div><div class='t2'>" & FORMAT ( [Gas para generar electricidad], "0.0%" ) & "</div><div class='t3'>" & "del consumo de " & FORMAT ( [Fecha del consumo de gas], "mmmm yyyy", "es-ES" ) & "</div></div></div>"
			            & "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m22 7-8.5 8.5-5-5L2 17'/><path d='M16 7h6v6'/></svg></div><div><div class='t1'>Semanas seguidas almacenando más</div><div class='t2'>" & FORMAT ( [Semanas seguidas en aumento], "0" ) & "</div><div class='t3'>" & "el gas guardado sube cada semana" & "</div></div></div>",
			        "pet", "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 10.6 5 12.5 5 15a7 7 0 0 0 7 7z'/></svg></div><div><div class='t1'>Precio del crudo · Brent</div><div class='t2'>" & FORMAT ( [Brent último], "#,0.00" ) & " US$" & "</div><div class='t3'>" & FORMAT ( ABS ( [Diferencial Brent WTI] ), "#,0.00" ) & IF ( [Diferencial Brent WTI] >= 0, " US$ más caro", " US$ más barato" ) & " que el WTI" & "</div></div></div>"
			            & "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 22h12M4 9h10M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18'/><path d='M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 4 0V9.83a2 2 0 0 0-.59-1.42L18 5'/></svg></div><div><div class='t1'>Diésel en el surtidor</div><div class='t2'>" & FORMAT ( [Diésel], "#,0.00" ) & " US$/gal" & "</div><div class='t3'>" & FORMAT ( ABS ( [Variación de diésel] ), "0.0%" ) & IF ( [Variación de diésel] < 0, " más barato", " más caro" ) & " que la semana anterior" & "</div></div></div>",
			        "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z'/></svg></div><div><div class='t1'>Fuente principal</div><div class='t2'>" & [Fuente principal] & "</div><div class='t3'>" & FORMAT ( [Participación de la fuente principal], "0.0%" ) & " de la electricidad generada" & "</div></div></div>"
			            & "<div class='flot'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z'/><circle cx='12' cy='10' r='3'/></svg></div><div><div class='t1'>Región con más consumo</div><div class='t2'>" & [Región con más consumo] & "</div><div class='t3'>" & FORMAT ( [Consumo de la región líder], "#,0.00" ) & " TWh · " & FORMAT ( [Participación de la región líder], "0.0%" ) & " del país" & "</div></div></div>"
			    )
			    & "</div>"
		displayFolder: 6. HTML
		lineageTag: bca88dbb-8cef-4ef5-9fb6-db3d7179b65b

	/// Tira de cinco indicadores del sector. Cada tarjeta se voltea al pasar el mouse y explica en lenguaje simple qué significa el indicador.
	measure 'HTML Indicadores' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.tira{display:flex;gap:18px}.k{width:360px;height:112px;perspective:900px}.in{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d}.k:hover .in{transform:rotateY(180deg)}.f,.b{position:absolute;inset:0;border-radius:22px;backface-visibility:hidden;-webkit-backface-visibility:hidden;padding:16px 18px}.f{background:#fff;border:1px solid #E1E8F0;display:flex;gap:14px;align-items:center}.b{transform:rotateY(180deg);background:#12223A;color:#DCE6F3;font-size:12px;line-height:1.45;display:flex;align-items:center}.ico{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;flex:none}.ico svg{width:20px;height:20px}.cu{flex:1;min-width:0}.fi{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.v{font-size:25px;font-weight:700;letter-spacing:-.5px;white-space:nowrap}.v small{font-size:12px;color:#4F6078;font-weight:600;margin-left:3px;letter-spacing:0}.l{font-size:12.5px;font-weight:600;margin-top:2px}.d{font-size:11.5px;color:#4F6078;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style><div class='tira'>"
			    & SWITCH (
			        _s,
			        "gas", "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='3'/><path d='M16 2v4M8 2v4M3 10h18'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Promedio del mes del Henry Hub], "#,0.00" ) & "<small>US$/MMBtu</small></div>" & "" & "</div><div class='l'>" & "Precio promedio del mes" & "</div><div class='d'>" & "Henry Hub · " & FORMAT ( [Fecha del Henry Hub], "mmmm", "es-ES" ) & "</div></div></div><div class='b'>Promedio de los precios diarios del Henry Hub en el mes del último dato. Henry Hub es el punto de Luisiana donde se fija el precio de referencia del gas en EE. UU.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m17 2 4 4-4 4'/><path d='M3 11v-1a4 4 0 0 1 4-4h14'/><path d='m7 22-4-4 4-4'/><path d='M21 13v1a4 4 0 0 1-4 4H3'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Gas almacenado hace un año], "#,0" ) & "<small>Bcf</small></div>" & IF ( ISBLANK ( [Variación del gas almacenado vs hace un año] ), "", "<span class='chip " & IF ( [Variación del gas almacenado vs hace un año] > 0, "up", IF ( [Variación del gas almacenado vs hace un año] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del gas almacenado vs hace un año] > 0, "▲ ", IF ( [Variación del gas almacenado vs hace un año] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del gas almacenado vs hace un año] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Gas almacenado hace un año" & "</div><div class='d'>" & "el " & SUBSTITUTE ( FORMAT ( [Fecha del almacenamiento] - 364, "d mmm yyyy", "es-ES" ), ".", "" ) & "</div></div></div><div class='b'>Gas en almacenamiento subterráneo hace 52 semanas en los 48 estados contiguos (Lower 48). Bcf: miles de millones de pies cúbicos.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m12 2 10 5-10 5L2 7z'/><path d='m2 17 10 5 10-5'/><path d='m2 12 10 5 10-5'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Cambio semanal del gas almacenado], "+#,0;-#,0;0" ) & "<small>Bcf</small></div>" & "" & "</div><div class='l'>" & "Cambio de la semana" & "</div><div class='d'>" & IF ( [Cambio semanal del gas almacenado] >= 0, "gas que entró al almacenamiento", "gas que salió del almacenamiento" ) & "</div></div></div><div class='b'>Gas que entró (+) o salió (−) del almacenamiento en la última semana reportada.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Consumo de gas del mes], "#,0" ) & "<small>Bcf</small></div>" & IF ( ISBLANK ( [Variación del consumo de gas] ), "", "<span class='chip " & IF ( [Variación del consumo de gas] > 0, "up", IF ( [Variación del consumo de gas] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del consumo de gas] > 0, "▲ ", IF ( [Variación del consumo de gas] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del consumo de gas] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Consumo de " & FORMAT ( [Fecha del consumo de gas], "mmmm", "es-ES" ) & "</div><div class='d'>" & "vs. mes anterior" & "</div></div></div><div class='b'>Consumo total de gas natural en EE. UU. del último mes publicado. La EIA lo publica con unos tres meses de retraso.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z'/><circle cx='12' cy='10' r='3'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & [Región con más gas almacenado] & "<small></small></div>" & "" & "</div><div class='l'>" & "Región con más gas guardado" & "</div><div class='d'>" & FORMAT ( [Gas en la región líder], "#,0" ) & " Bcf · " & FORMAT ( [Participación de la región líder de gas], "0.0%" ) & " del total" & "</div></div></div><div class='b'>Región con más gas almacenado en la última semana. La EIA divide el país en cinco regiones: Este, Medio Oeste, Centro Sur, Montaña y Pacífico.</div></div></div>",
			        "pet", "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 22h12M4 9h10M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18'/><path d='M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 4 0V9.83a2 2 0 0 0-.59-1.42L18 5'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Gasolina regular], "#,0.00" ) & "<small>US$/gal</small></div>" & IF ( ISBLANK ( [Variación de gasolina regular] ), "", "<span class='chip " & IF ( [Variación de gasolina regular] > 0, "up", IF ( [Variación de gasolina regular] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de gasolina regular] > 0, "▲ ", IF ( [Variación de gasolina regular] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de gasolina regular] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Gasolina regular" & "</div><div class='d'>" & "en el surtidor · " & SUBSTITUTE ( FORMAT ( [Fecha del precio minorista], "d mmm yyyy", "es-ES" ), ".", "" ) & "</div></div></div><div class='b'>Precio promedio en el surtidor de la gasolina regular en EE. UU., con impuestos. Se publica cada semana. 1 galón ≈ 3,8 litros.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 22h12M4 9h10M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18'/><path d='M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 4 0V9.83a2 2 0 0 0-.59-1.42L18 5'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Gasolina premium], "#,0.00" ) & "<small>US$/gal</small></div>" & IF ( ISBLANK ( [Variación de gasolina premium] ), "", "<span class='chip " & IF ( [Variación de gasolina premium] > 0, "up", IF ( [Variación de gasolina premium] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de gasolina premium] > 0, "▲ ", IF ( [Variación de gasolina premium] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de gasolina premium] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Gasolina premium" & "</div><div class='d'>" & "vs. semana anterior" & "</div></div></div><div class='b'>Precio promedio en el surtidor de la gasolina premium en EE. UU., con impuestos. Se publica cada semana.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Reserva estratégica], "#,0.0" ) & "<small>M bbl</small></div>" & IF ( ISBLANK ( [Variación de reserva estratégica] ), "", "<span class='chip " & IF ( [Variación de reserva estratégica] > 0, "up", IF ( [Variación de reserva estratégica] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de reserva estratégica] > 0, "▲ ", IF ( [Variación de reserva estratégica] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de reserva estratégica] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Reserva estratégica" & "</div><div class='d'>" & "crudo de emergencia del gobierno" & "</div></div></div><div class='b'>Petróleo de emergencia que guarda el gobierno de EE. UU. (Strategic Petroleum Reserve), en millones de barriles.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M3 5v14a9 3 0 0 0 18 0V5'/><path d='M3 12a9 3 0 0 0 18 0'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Gasolina almacenada], "#,0.0" ) & "<small>M bbl</small></div>" & IF ( ISBLANK ( [Variación de gasolina almacenada] ), "", "<span class='chip " & IF ( [Variación de gasolina almacenada] > 0, "up", IF ( [Variación de gasolina almacenada] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de gasolina almacenada] > 0, "▲ ", IF ( [Variación de gasolina almacenada] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de gasolina almacenada] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Gasolina almacenada" & "</div><div class='d'>" & "vs. semana anterior" & "</div></div></div><div class='b'>Inventario semanal de gasolina terminada y componentes en EE. UU., en millones de barriles.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M3 5v14a9 3 0 0 0 18 0V5'/><path d='M3 12a9 3 0 0 0 18 0'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Destilados almacenados], "#,0.0" ) & "<small>M bbl</small></div>" & IF ( ISBLANK ( [Variación de destilados almacenados] ), "", "<span class='chip " & IF ( [Variación de destilados almacenados] > 0, "up", IF ( [Variación de destilados almacenados] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación de destilados almacenados] > 0, "▲ ", IF ( [Variación de destilados almacenados] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación de destilados almacenados] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Diésel y otros destilados" & "</div><div class='d'>" & "almacenados · vs. semana anterior" & "</div></div></div><div class='b'>Inventario semanal de destilados: sobre todo diésel y combustible de calefacción, en millones de barriles.</div></div></div>",
			        "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Pronóstico del último día], "#,0.00" ) & "<small>TWh</small></div>" & "" & "</div><div class='l'>" & "Pronóstico del día anterior" & "</div><div class='d'>" & "lo que la red esperaba para el " & SUBSTITUTE ( FORMAT ( [Día cerrado de electricidad], "d mmm yyyy", "es-ES" ), ".", "" ) & "</div></div></div><div class='b'>Consumo que los operadores de la red (PJM, MISO, ERCOT…) estimaron el día anterior. Lo reportan a la EIA en el formulario EIA-930.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m12 14 4-4'/><path d='M3.34 19a10 10 0 1 1 17.32 0'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Error del pronóstico] * 100, "+0.0;-0.0;0.0" ) & "<small>%</small></div>" & "" & "</div><div class='l'>" & "Error del pronóstico" & "</div><div class='d'>" & IF ( [Error del pronóstico] < 0, "pronosticó menos de lo que se consumió", "pronosticó más de lo que se consumió" ) & "</div></div></div><div class='b'>Diferencia entre el pronóstico y el consumo real, como porcentaje del consumo. Negativo: se pronosticó menos de lo que se consumió.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2 4 14h7l-1 8 9-12h-7z'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Generación del último día], "#,0.00" ) & "<small>TWh</small></div>" & "" & "</div><div class='l'>" & "Electricidad generada" & "</div><div class='d'>" & "cubre el " & FORMAT ( [Cobertura de la generación], "0.0%" ) & " del consumo" & "</div></div></div><div class='b'>Generación neta de las centrales de los 48 estados contiguos. La diferencia con el consumo se cubre con importaciones.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M8 3 4 7l4 4'/><path d='M4 7h16'/><path d='m16 21 4-4-4-4'/><path d='M20 17H4'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( ABS ( [Intercambio del último día] ), "#,0.00" ) & "<small>TWh</small></div>" & "" & "</div><div class='l'>" & IF ( [Intercambio del último día] < 0, "Importación neta", "Exportación neta" ) & "</div><div class='d'>" & IF ( [Intercambio del último día] < 0, "llega desde Canadá y México", "sale hacia Canadá y México" ) & "</div></div></div><div class='b'>Electricidad que entra desde Canadá y México menos la que sale. Negativo en la EIA: el país importa.</div></div></div>"
			            & "<div class='k'><div class='in'><div class='f'><div class='ico' style='background:" & _tint & ";color:" & _act & "'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='3'/><path d='M16 2v4M8 2v4M3 10h18'/></svg></div><div class='cu'><div class='fi'><div class='v'>" & FORMAT ( [Consumo hace un año], "#,0.00" ) & "<small>TWh</small></div>" & IF ( ISBLANK ( [Variación del consumo vs hace un año] ), "", "<span class='chip " & IF ( [Variación del consumo vs hace un año] > 0, "up", IF ( [Variación del consumo vs hace un año] < 0, "dn", "nt" ) ) & "'>" & IF ( [Variación del consumo vs hace un año] > 0, "▲ ", IF ( [Variación del consumo vs hace un año] < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( [Variación del consumo vs hace un año] ), "0.0%" ) & "</span>" ) & "</div><div class='l'>" & "Mismo día del año pasado" & "</div><div class='d'>" & "consumo del " & SUBSTITUTE ( FORMAT ( [Día cerrado de electricidad] - 364, "d mmm yyyy", "es-ES" ), ".", "" ) & "</div></div></div><div class='b'>Consumo de hace 52 semanas, el mismo día de la semana, para comparar sin el efecto del fin de semana.</div></div></div>"
			    )
			    & "</div>"
		displayFolder: 6. HTML
		lineageTag: 91577cb9-c87c-43e2-8ffc-fb22b368a3a1

	/// Tarjeta con tres frases que resumen el último dato del sector elegido.
	measure 'HTML Claves' =
			VAR _s = [Sector seleccionado]
			VAR _ac = SWITCH ( _s, "gas", "#2E9BE6", "pet", "#EF6A3A", "#F2B01E" )
			VAR _act = SWITCH ( _s, "gas", "#0E5C98", "pet", "#A2380F", "#7F5300" )
			VAR _tint = SWITCH ( _s, "gas", "#D9EDFC", "pet", "#FBE0D4", "#FFF1CC" )
			VAR _tint2 = SWITCH ( _s, "gas", "#F1F8FF", "pet", "#FFF5F0", "#FFFAEB" )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.cl{width:100%;height:100%;border-radius:26px;border:1px solid #E1E8F0;padding:20px 26px}.cl h2{font-size:17px;font-weight:700;letter-spacing:-.2px}.cl ul{list-style:none;margin-top:12px;display:flex;flex-direction:column;gap:9px}.cl li{display:flex;gap:10px;font-size:13px;line-height:1.45;color:#4F6078}.cl li i{flex:none;width:7px;height:7px;border-radius:50%;margin-top:7px}.cl li b{color:#0F1E33}</style><div class='cl' style='background:linear-gradient(135deg," & _tint2 & ",#FFFFFF 60%)'><h2>Claves del último dato</h2><ul>"
			    & SWITCH (
			        _s,
			        "gas", "<li><i style='background:" & _ac & "'></i><span>" & "El <b>" & FORMAT ( [Gas para generar electricidad], "0.0%" ) & "</b> del gas consumido en " & FORMAT ( [Fecha del consumo de gas], "mmmm yyyy", "es-ES" ) & " se usó para generar electricidad." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & "Hay <b>" & FORMAT ( ABS ( [Variación del gas almacenado vs hace un año] ), "0.0%" ) & IF ( [Variación del gas almacenado vs hace un año] < 0, " menos", " más" ) & "</b> gas almacenado que hace un año (" & FORMAT ( [Gas almacenado hace un año], "#,0" ) & " Bcf)." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & IF ( DATEDIFF ( [Fecha del último futuro], [Fecha del Henry Hub], DAY ) > 30, "El precio a futuro a un mes (RNGC1) <b>no publica datos desde el " & SUBSTITUTE ( FORMAT ( [Fecha del último futuro], "d mmm yyyy", "es-ES" ), ".", "" ) & "</b>.", "El precio a futuro a un mes (RNGC1) está al día." ) & "</span></li>",
			        "pet", "<li><i style='background:" & _ac & "'></i><span>" & "El crudo <b>Brent</b> está " & FORMAT ( ABS ( [Diferencial Brent WTI] ), "#,0.00" ) & IF ( [Diferencial Brent WTI] >= 0, " US$ más caro", " US$ más barato" ) & " que el WTI." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & "La <b>reserva estratégica</b> " & IF ( [Variación de reserva estratégica] < 0, "bajó", "subió" ) & " a " & FORMAT ( [Reserva estratégica], "#,0.0" ) & " M bbl (" & FORMAT ( ABS ( [Variación de reserva estratégica] ), "0.0%" ) & " en la semana)." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & "El diésel cuesta <b>" & FORMAT ( [Diésel vs gasolina regular], "#,0.00" ) & " US$ más</b> por galón que la gasolina regular." & "</span></li>",
			        "<li><i style='background:" & _ac & "'></i><span>" & "<b>" & [Fuente principal] & "</b> fue la fuente principal con " & FORMAT ( [Participación de la fuente principal], "0.0%" ) & " de la electricidad generada." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & "La región <b>" & [Región con más consumo] & "</b> concentró el " & FORMAT ( [Participación de la región líder], "0.0%" ) & " del consumo del país." & "</span></li>"
			            & "<li><i style='background:" & _ac & "'></i><span>" & "Los operadores de la red pronosticaron <b>" & FORMAT ( ABS ( [Error del pronóstico] ), "0.0%" ) & IF ( [Error del pronóstico] < 0, " menos", " más" ) & "</b> de lo que realmente se consumió." & "</span></li>"
			    )
			    & "</ul></div>"
		displayFolder: 6. HTML
		lineageTag: 19b45c0a-524f-462f-97f9-a1aa79bf6b5a

	/// Panel que se abre con el botón de frescura: última fecha de cada una de las 9 tablas Silver, días de antigüedad y si está al día según su frecuencia.
	measure 'HTML Panel de frescura' =
			VAR _hoy = TODAY ()
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}body,div{font-family:'Segoe UI','Segoe UI Variable',sans-serif;color:#0F1E33}.chip{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap}.chip.up{color:#15803D;background:#DCF5E6}.chip.dn{color:#BE2F4A;background:#FDE3E8}.chip.nt{color:#4F6078;background:#EEF2F7}.pa{width:100%;height:100%;background:#fff;border-radius:28px;padding:28px 30px}.pa h3{font-size:22px;font-weight:700}.pa .s{font-size:13px;color:#4F6078;margin-top:4px}.res{display:flex;gap:12px;margin:16px 0 14px}.res div{flex:1;background:#F4F7FA;border-radius:16px;padding:12px 14px;font-size:12px;color:#4F6078}.res b{display:block;font-size:22px;color:#0F1E33}.tf{display:grid;grid-template-columns:16px 240px 280px 80px 100px 44px 80px;gap:12px;align-items:center;font-size:12.5px;padding:9px 6px;border-bottom:1px solid #EEF2F6;white-space:nowrap}.tf.h{font-size:10.5px;font-weight:700;letter-spacing:1px;color:#7F8EA4;text-transform:uppercase}.tf code{font-family:Consolas,monospace;font-size:11.5px;color:#4F6078}.cat{width:10px;height:10px;border-radius:3px}.ok{border-radius:999px;font-weight:700;font-size:11px;padding:2px 10px;text-align:center}.nota{font-size:11.5px;color:#7F8EA4;margin-top:12px}</style><div class='pa'><h3>Frescura de los datos</h3>"
			    & "<div class='s'>Última fecha disponible de cada tabla Silver frente a la frecuencia con la que la EIA la publica.</div>"
			    & "<div class='res'><div><b>" & [Tablas al día] & " de 9</b>tablas al día</div><div><b>1 ene 2023</b>inicio de la historia</div><div><b>" & SUBSTITUTE ( FORMAT ( _hoy, "d mmm yyyy", "es-ES" ), ".", "" ) & "</b>fecha de la revisión</div></div>"
			    & "<div class='tf h'><span></span><span>Dataset</span><span>Tabla</span><span>Frecuencia</span><span>Último dato</span><span>Días</span><span>Estado</span></div>"
			    & "<div class='tf'><span class='cat' style='background:#F2B01E'></span><span>Demanda por región</span><code>silver.rto_demanda_region</code><span>Diaria</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Demanda por región], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Demanda por región], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Demanda por región] ) && DATEDIFF ( [Último dato · Demanda por región], _hoy, DAY ) <= 7, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#F2B01E'></span><span>Generación por fuente</span><code>silver.rto_generacion_combustible</code><span>Diaria</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Generación por fuente], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Generación por fuente], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Generación por fuente] ) && DATEDIFF ( [Último dato · Generación por fuente], _hoy, DAY ) <= 7, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#F2B01E'></span><span>Intercambio entre regiones</span><code>silver.rto_intercambio</code><span>Diaria</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Intercambio entre regiones], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Intercambio entre regiones], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Intercambio entre regiones] ) && DATEDIFF ( [Último dato · Intercambio entre regiones], _hoy, DAY ) <= 7, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#EF6A3A'></span><span>Precio spot del crudo</span><code>silver.precio_spot_crudo</code><span>Diaria</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Precio spot del crudo], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Precio spot del crudo], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Precio spot del crudo] ) && DATEDIFF ( [Último dato · Precio spot del crudo], _hoy, DAY ) <= 7, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#EF6A3A'></span><span>Precio minorista de combustibles</span><code>silver.precio_minorista_combustibles</code><span>Semanal</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Precio minorista de combustibles], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Precio minorista de combustibles], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Precio minorista de combustibles] ) && DATEDIFF ( [Último dato · Precio minorista de combustibles], _hoy, DAY ) <= 14, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#EF6A3A'></span><span>Inventarios semanales</span><code>silver.inventarios_semanales</code><span>Semanal</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Inventarios semanales], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Inventarios semanales], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Inventarios semanales] ) && DATEDIFF ( [Último dato · Inventarios semanales], _hoy, DAY ) <= 14, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#2E9BE6'></span><span>Precio Henry Hub</span><code>silver.precio_henry_hub</code><span>Diaria</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Precio Henry Hub], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Precio Henry Hub], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Precio Henry Hub] ) && DATEDIFF ( [Último dato · Precio Henry Hub], _hoy, DAY ) <= 7, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#2E9BE6'></span><span>Almacenamiento de gas</span><code>silver.almacenamiento_gas</code><span>Semanal</span><span>" & SUBSTITUTE ( FORMAT ( [Último dato · Almacenamiento de gas], "d mmm yyyy", "es-ES" ), ".", "" ) & "</span><span>" & DATEDIFF ( [Último dato · Almacenamiento de gas], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Almacenamiento de gas] ) && DATEDIFF ( [Último dato · Almacenamiento de gas], _hoy, DAY ) <= 14, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='tf'><span class='cat' style='background:#2E9BE6'></span><span>Consumo de gas por sector</span><code>silver.consumo_gas_sector</code><span>Mensual</span><span>" & FORMAT ( [Último dato · Consumo de gas por sector], "mmmm yyyy", "es-ES" ) & "</span><span>" & DATEDIFF ( [Último dato · Consumo de gas por sector], _hoy, DAY ) & "</span>" & IF ( NOT ISBLANK ( [Último dato · Consumo de gas por sector] ) && DATEDIFF ( [Último dato · Consumo de gas por sector], _hoy, DAY ) <= 120, "<span class='ok' style='color:#15803D;background:#DCF5E6'>Al día</span>", "<span class='ok' style='color:#BE2F4A;background:#FDE3E8'>Atrasado</span>" ) & "</div>"
			    & "<div class='nota'>Regla: al día si el último dato tiene hasta 7 días (diaria), 14 (semanal) o 120 (mensual). La electricidad solo se guarda hasta dos días antes de la carga, porque la EIA publica el día en curso incompleto.</div></div>"
		displayFolder: 6. HTML
		lineageTag: f6858508-7ed9-456b-b903-8910d476e0fb

	/// Ícono de cada sector (rayo, llama o gota) como imagen SVG, en el color de su sector sobre un cuadro blanco. Se usa en las imágenes de la segmentación de botones con formato condicional (fx > Valor de campo).
	measure 'Icono del sector' =
			SWITCH (
			    SELECTEDVALUE ( Sector[Clave] ),
			    "el", "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='13' fill='%23FFFFFF' fill-opacity='0.8'/><g transform='translate(8 8)' fill='none' stroke='%23B07A00' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2 4 14h7l-1 8 9-12h-7z'/></g></svg>",
			    "gas", "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='13' fill='%23FFFFFF' fill-opacity='0.8'/><g transform='translate(8 8)' fill='none' stroke='%231673B8' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z'/></g></svg>",
			    "pet", "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='13' fill='%23FFFFFF' fill-opacity='0.8'/><g transform='translate(8 8)' fill='none' stroke='%23C2410C' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 10.6 5 12.5 5 15a7 7 0 0 0 7 7z'/></g></svg>"
			)
		displayFolder: 0. Sector
		lineageTag: 68f94f6b-10de-45bf-8c72-25cfde071d73
		dataCategory: ImageUrl

	/// Banner superior del tablero para el visual HTML Content: degradado del sector, ilustración isométrica animada y fecha del último dato. El banner ocupa solo la franja de arriba (alto = 392/1872 del ancho del visual) con un pequeño margen a los lados; debajo queda transparente para que se vea el fondo de la página. Funciona aunque el visual ocupe toda la página. Envuelve [HTML Escena contenido].
	measure 'HTML Escena' =
			VAR _contenido =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                [HTML Escena contenido],
			                "radial-gradient(900px 420px at 52% 70%",
			                "radial-gradient(48vw 22.4vw at 52% 70%"
			            ),
			            ".hero{position:relative;width:100%;height:100%;border-radius:32px;overflow:hidden}",
			            ".hero{position:relative;margin:0 0.7vw;width:calc(100vw - 1.4vw);height:20.94vw;border-radius:32px;overflow:hidden;box-shadow:0 18px 40px -28px rgba(15,30,51,.35)}"
			        ),
			        ".esc{position:absolute;left:34.2%;top:0;width:46%;height:100%}",
			        ".esc{position:absolute;left:34.2vw;top:0;width:46vw;height:100%}"
			    )
			RETURN
			    "<style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}</style>"
			        & "<div style='position:relative;width:100vw;height:100vh;overflow:hidden'>" & _contenido & "</div>"
		displayFolder: 6. HTML
		lineageTag: d9e34bf2-14b0-4934-a295-2533ec94b357

	/// Píldora 'Frescura N/9' con un punto que late: verde si las 9 tablas están al día y coral si alguna está atrasada. Va en un HTML Content de 150 × 38; encima se pone un botón nativo transparente con la acción del marcador que abre el panel de frescura.
	measure 'HTML Botón de frescura' =
			VAR _ok = [Tablas al día] = 9
			VAR _color = IF ( _ok, "#22C55E", "#F97066" )
			VAR _halo = IF ( _ok, "rgba(34,197,94,.22)", "rgba(249,112,102,.25)" )
			RETURN
			    "<style>html,body{margin:0;padding:0;background:transparent;overflow:hidden}*{box-sizing:border-box}"
			        & ".p{width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;gap:9px;border-radius:999px;background:rgba(255,255,255,.9);border:1px solid #E1E8F0;font-family:'Segoe UI','Segoe UI Variable',sans-serif;font-size:12.5px;font-weight:600;color:#0F1E33}"
			        & ".d{width:9px;height:9px;border-radius:50%;flex:none;animation:late 2.2s ease-in-out infinite}"
			        & "@keyframes late{0%,100%{box-shadow:0 0 0 3px " & _halo & "}50%{box-shadow:0 0 0 6px " & _halo & "}}</style>"
			        & "<div class='p'><span class='d' style='background:" & _color & "'></span>" & [Texto del botón de frescura] & "</div>"
		displayFolder: 6. HTML
		lineageTag: 072b0b17-c002-4a09-857a-72691d1554f9

	column 'Columna 1'
		dataType: string
		isHidden
		lineageTag: 358567d1-36d4-4221-bdef-adb1a7e45ce2
		summarizeBy: none
		sourceColumn: Columna 1

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Columna 1" = _t])
				in
				  Origen

	annotation PBI_ResultType = Table

