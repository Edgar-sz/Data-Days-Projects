		summarizeBy: none
		sourceColumn: fecha_key

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Precio de una unidad del activo, en USD. No se suma: usa promedios o el valor de un activo.
	column precio_usd
		dataType: double
		lineageTag: 64acf321-0500-4473-bdeb-4e1e668911ad
		summarizeBy: none
		sourceColumn: precio_usd

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Tamaño del activo: precio por unidades en circulación, en USD.
	column capitalizacion_usd
		dataType: double
		lineageTag: c6211e73-78b0-470b-b108-8b1e6ff1ffc8
		summarizeBy: none
		sourceColumn: capitalizacion_usd

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Dinero negociado con el activo en las últimas 24 horas, en USD.
	column volumen_24h_usd
		dataType: double
		lineageTag: 37810a3a-27a8-4e93-b52e-27650cee3c2f
