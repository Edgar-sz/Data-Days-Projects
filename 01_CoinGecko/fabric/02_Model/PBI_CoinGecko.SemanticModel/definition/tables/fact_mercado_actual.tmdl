		isHidden
		formatString: 0
		lineageTag: e4a6046a-2c25-4a81-a7fb-b19cc3ea5e95
		summarizeBy: none
		sourceColumn: lote_key

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Clave hacia dim_fecha.
