		isHidden
		formatString: 0
		lineageTag: cd1365ee-82ce-4ca9-b027-d85df9ab2cc5
		summarizeBy: none
		sourceColumn: activo_key

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Clave hacia dim_lote. Está oculta.
	column lote_key
